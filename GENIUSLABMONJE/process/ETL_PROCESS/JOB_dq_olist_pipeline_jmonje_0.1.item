  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="80" posY="280">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MySQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:4+Y+Yoj4U1T962BHvHzHGatpDdKaVGQmrGKluAdY" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;customer_id\&quot;:\&quot;', IFNULL(customer_id,''), '\&quot;,\&quot;order_status\&quot;:\&quot;', IFNULL(order_status,''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-001' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Completitud' AS dimension, &quot; +&#xD;&#xA;&quot;       'Crítica' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN customer_id IS NOT NULL AND TRIM(customer_id) &lt;> '' THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_status\&quot;:\&quot;', IFNULL(order_status,''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-002' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Validez' AS dimension, &quot; +&#xD;&#xA;&quot;       'Crítica' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN order_status IN ('delivered','shipped','canceled','unavailable','invoiced','processing','approved','created') THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       o.order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(o.order_id,''), '\&quot;,\&quot;cnt_order_id\&quot;:\&quot;', IFNULL(CAST(d.cnt_order_id AS CHAR),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-003' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Unicidad' AS dimension, &quot; +&#xD;&#xA;&quot;       'Crítica' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN d.cnt_order_id = 1 THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje o &quot; +&#xD;&#xA;&quot;JOIN ( &quot; +&#xD;&#xA;&quot;    SELECT order_id, COUNT(*) AS cnt_order_id &quot; +&#xD;&#xA;&quot;    FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&quot;    GROUP BY order_id &quot; +&#xD;&#xA;&quot;) d ON o.order_id = d.order_id &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_order_items_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       CONCAT(order_id, '-', order_item_id) AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_item_id\&quot;:\&quot;', IFNULL(order_item_id,''), '\&quot;,\&quot;price\&quot;:\&quot;', IFNULL(price,''), '\&quot;,\&quot;price_num\&quot;:\&quot;', IFNULL(CAST(price_num AS CHAR),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-004' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Validez' AS dimension, &quot; +&#xD;&#xA;&quot;       'Alta' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN price_num IS NOT NULL AND price_num > 0 THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_order_items_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_purchase_ts\&quot;:\&quot;', IFNULL(DATE_FORMAT(order_purchase_ts, '%Y-%m-%d %H:%i:%s'),''), '\&quot;,\&quot;order_delivered_customer_ts\&quot;:\&quot;', IFNULL(DATE_FORMAT(order_delivered_customer_ts, '%Y-%m-%d %H:%i:%s'),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-005' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Consistencia' AS dimension, &quot; +&#xD;&#xA;&quot;       'Alta' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN order_delivered_customer_ts IS NULL OR order_purchase_ts IS NULL OR order_delivered_customer_ts >= order_purchase_ts THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_customers_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       customer_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;customer_id\&quot;:\&quot;', IFNULL(customer_id,''), '\&quot;,\&quot;customer_unique_id\&quot;:\&quot;', IFNULL(customer_unique_id,''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-006' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Completitud' AS dimension, &quot; +&#xD;&#xA;&quot;       'Crítica' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN customer_unique_id IS NOT NULL AND TRIM(customer_unique_id) &lt;> '' THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_customers_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_customers_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       customer_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;customer_id\&quot;:\&quot;', IFNULL(customer_id,''), '\&quot;,\&quot;customer_state\&quot;:\&quot;', IFNULL(customer_state,''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-007' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Validez' AS dimension, &quot; +&#xD;&#xA;&quot;       'Alta' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN customer_state IN ('AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO') THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_customers_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_status\&quot;:\&quot;', IFNULL(order_status,''), '\&quot;,\&quot;order_delivered_customer_ts\&quot;:\&quot;', IFNULL(DATE_FORMAT(order_delivered_customer_ts, '%Y-%m-%d %H:%i:%s'),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-008' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Completitud' AS dimension, &quot; +&#xD;&#xA;&quot;       'Crítica' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN order_status &lt;> 'delivered' OR order_delivered_customer_ts IS NOT NULL THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_status\&quot;:\&quot;', IFNULL(order_status,''), '\&quot;,\&quot;order_approved_ts\&quot;:\&quot;', IFNULL(DATE_FORMAT(order_approved_ts, '%Y-%m-%d %H:%i:%s'),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-009' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Completitud' AS dimension, &quot; +&#xD;&#xA;&quot;       'Alta' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN order_status IN ('created','canceled','unavailable') OR order_approved_ts IS NOT NULL THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje &quot; +&#xD;&#xA;&#xD;&#xA;&quot;UNION ALL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT '&quot; + context.run_id + &quot;' AS run_id, &quot; +&#xD;&#xA;&quot;       NOW(6) AS run_ts, &quot; +&#xD;&#xA;&quot;       'olist_orders_dataset' AS dataset, &quot; +&#xD;&#xA;&quot;       order_id AS business_key, &quot; +&#xD;&#xA;&quot;       CONCAT('{\&quot;order_id\&quot;:\&quot;', IFNULL(order_id,''), '\&quot;,\&quot;order_status\&quot;:\&quot;', IFNULL(order_status,''), '\&quot;,\&quot;order_delivered_carrier_ts\&quot;:\&quot;', IFNULL(DATE_FORMAT(order_delivered_carrier_ts, '%Y-%m-%d %H:%i:%s'),''), '\&quot;}') AS payload_json, &quot; +&#xD;&#xA;&quot;       'DQ-010' AS rule_id, &quot; +&#xD;&#xA;&quot;       'Consistencia' AS dimension, &quot; +&#xD;&#xA;&quot;       'Alta' AS severity, &quot; +&#xD;&#xA;&quot;       CASE WHEN order_status NOT IN ('delivered','shipped') OR order_delivered_carrier_ts IS NOT NULL THEN 1 ELSE 0 END AS rule_passed_int &quot; +&#xD;&#xA;&quot;FROM stg_v_orders_dq_jmonje&quot;"/>
