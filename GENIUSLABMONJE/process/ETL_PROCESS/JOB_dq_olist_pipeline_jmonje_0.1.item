  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="240" posY="120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="context.run_id = &quot;RUN-&quot; + System.currentTimeMillis();&#xD;&#xA;context.run_ts = TalendDate.getCurrentDate();&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;=========================================&quot;);&#xD;&#xA;System.out.println(&quot;INICIANDO JOB DQ OLIST&quot;);&#xD;&#xA;System.out.println(&quot;RUN_ID: &quot; + context.run_id);&#xD;&#xA;System.out.println(&quot;RUN_TS: &quot; + context.run_ts);&#xD;&#xA;System.out.println(&quot;ENV: &quot; + context.env);&#xD;&#xA;System.out.println(&quot;STRICT_MODE: &quot; + context.strict_mode);&#xD;&#xA;System.out.println(&quot;=========================================&quot;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="tJava_INIT_RUN"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
