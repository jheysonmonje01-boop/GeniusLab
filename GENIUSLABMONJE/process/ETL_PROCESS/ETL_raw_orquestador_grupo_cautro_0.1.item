  <node componentName="tMysqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="1280" posY="440">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_2" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MySQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:ioczDtaWwndBL1y65Bg8HCquatAYUip58ren8yig" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;UPDATE etl_run_audit_grupo_cuatro a &quot;&#xD;&#xA;+ &quot;JOIN ( &quot;&#xD;&#xA;+ &quot;    SELECT &quot;&#xD;&#xA;+ &quot;        COALESCE(SUM(rows_inserted), 0) AS total_rows_inserted, &quot;&#xD;&#xA;+ &quot;        COALESCE(( &quot;&#xD;&#xA;+ &quot;            SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;            FROM raw_ingest_rejects_grupo_cuatro &quot;&#xD;&#xA;+ &quot;            WHERE run_id = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        ), 0) AS total_rows_rejected &quot;&#xD;&#xA;+ &quot;    FROM ( &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) AS rows_inserted &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_products_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_customers_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_orders_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_order_items_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_order_payments_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_order_reviews_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_sellers_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;        UNION ALL &quot;&#xD;&#xA;+ &quot;        SELECT COUNT(*) &quot;&#xD;&#xA;+ &quot;        FROM raw_olist_product_category_translation_grupo_cuatro &quot;&#xD;&#xA;+ &quot;        WHERE _load_run = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;    ) x &quot;&#xD;&#xA;+ &quot;) s &quot;&#xD;&#xA;+ &quot;SET a.finished_at = NOW(6), &quot;&#xD;&#xA;+ &quot;a.status = 'SUCCESS', &quot;&#xD;&#xA;+ &quot;a.rows_inserted = s.total_rows_inserted, &quot;&#xD;&#xA;+ &quot;a.rows_rejected = s.total_rows_rejected, &quot;&#xD;&#xA;+ &quot;a.rows_read = s.total_rows_inserted + s.total_rows_rejected, &quot;&#xD;&#xA;+ &quot;a.rows_updated = 0, &quot;&#xD;&#xA;+ &quot;a.error_message = NULL &quot;&#xD;&#xA;+ &quot;WHERE a.run_id = '&quot; + context.run_id + &quot;' &quot;&#xD;&#xA;+ &quot;AND a.job_name = 'JOB_orquestador_raw_grupo_cuatro'&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;&quot;" show="false"/>
