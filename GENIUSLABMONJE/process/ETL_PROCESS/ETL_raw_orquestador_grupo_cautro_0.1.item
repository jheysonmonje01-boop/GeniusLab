  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="360" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//============================================================&#xD;&#xA;//PREPARACION DE EJECUCION ORQUESTADOR RAW&#xD;&#xA;//Objetivo:&#xD;&#xA;//Generar un unico run_id para toda la carga RAW.&#xD;&#xA;//Este run_id sera transmitido a todos los jobs hijos.&#xD;&#xA;//============================================================&#xD;&#xA;&#xD;&#xA;if (context.run_id == null || context.run_id.trim().length() == 0) {&#xD;&#xA; context.run_id = &quot;RUN_RAW_&quot; &#xD;&#xA;     + TalendDate.formatDate(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate());&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;context.run_ts = TalendDate.getCurrentDate();&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;RUN_ID_ORQUESTADOR_RAW&quot;, context.run_id);&#xD;&#xA;globalMap.put(&quot;RUN_TS_ORQUESTADOR_RAW&quot;, context.run_ts);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;====================================================&quot;);&#xD;&#xA;System.out.println(&quot;INICIO ORQUESTADOR RAW&quot;);&#xD;&#xA;System.out.println(&quot;RUN_ID: &quot; + context.run_id);&#xD;&#xA;System.out.println(&quot;RUN_TS: &quot; + context.run_ts);&#xD;&#xA;System.out.println(&quot;SOURCE_SYSTEM: &quot; + context.source_system);&#xD;&#xA;System.out.println(&quot;====================================================&quot;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
