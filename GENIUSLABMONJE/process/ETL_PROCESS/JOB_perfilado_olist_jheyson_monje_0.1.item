    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT &quot;&#xD;&#xA;+ &quot;'&quot; + context.run_id + &quot;' AS run_id, &quot;&#xD;&#xA;+ &quot;NOW(6) AS run_ts, &quot;&#xD;&#xA;+ &quot;'&quot; + ((String)globalMap.get(&quot;row1.dataset&quot;)) + &quot;' AS dataset, &quot;&#xD;&#xA;+ &quot;'&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;' AS column_name, &quot;&#xD;&#xA;+ &quot;'&quot; + ((String)globalMap.get(&quot;row1.data_type&quot;)) + &quot;' AS data_type, &quot;&#xD;&#xA;+ &quot;COUNT(*) AS rows_total, &quot;&#xD;&#xA;+ &quot;SUM(CASE WHEN `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;` IS NULL THEN 1 ELSE 0 END) AS rows_null, &quot;&#xD;&#xA;+ &quot;ROUND(100.0 * SUM(CASE WHEN `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;` IS NULL THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 3) AS pct_null, &quot;&#xD;&#xA;+ &quot;COUNT(DISTINCT `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;`) AS cardinality, &quot;&#xD;&#xA;+ &quot;CAST(MIN(`&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;`) AS CHAR) AS min_val, &quot;&#xD;&#xA;+ &quot;CAST(MAX(`&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;`) AS CHAR) AS max_val, &quot;&#xD;&#xA;+ &quot;ROUND(AVG(CHAR_LENGTH(CAST(`&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;` AS CHAR))), 2) AS avg_len, &quot;&#xD;&#xA;+ &quot;CAST((SELECT `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;` &quot;&#xD;&#xA;+ &quot;FROM `&quot; + ((String)globalMap.get(&quot;row1.table_name&quot;)) + &quot;` &quot;&#xD;&#xA;+ &quot;GROUP BY `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;` &quot;&#xD;&#xA;+ &quot;ORDER BY COUNT(*) DESC &quot;&#xD;&#xA;+ &quot;LIMIT 1) AS CHAR) AS pattern_top, &quot;&#xD;&#xA;+ &quot;COALESCE((SELECT ROUND(100.0 * MAX(cnt) / NULLIF((SELECT COUNT(*) FROM `&quot; + ((String)globalMap.get(&quot;row1.table_name&quot;)) + &quot;`), 0), 3) &quot;&#xD;&#xA;+ &quot;FROM (SELECT COUNT(*) AS cnt &quot;&#xD;&#xA;+ &quot;FROM `&quot; + ((String)globalMap.get(&quot;row1.table_name&quot;)) + &quot;` &quot;&#xD;&#xA;+ &quot;GROUP BY `&quot; + ((String)globalMap.get(&quot;row1.column_name&quot;)) + &quot;`) x), 0) AS pct_top &quot;&#xD;&#xA;+ &quot;FROM `&quot; + ((String)globalMap.get(&quot;row1.table_name&quot;)) + &quot;`&quot;"/>
