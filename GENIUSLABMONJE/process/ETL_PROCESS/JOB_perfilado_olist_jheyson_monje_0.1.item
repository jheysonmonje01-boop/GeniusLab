    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (context.run_id == null || context.run_id.trim().isEmpty()) {&#xD;&#xA;    context.run_id = &quot;RUN_DQ_PROFILE_&quot; + TalendDate.formatDate(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate());&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;context.run_ts = TalendDate.getCurrentDate();&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;=======================================&quot;);&#xD;&#xA;System.out.println(&quot;INICIANDO PERFILADO STG CURRENT&quot;);&#xD;&#xA;System.out.println(&quot;RUN_ID: &quot; + context.run_id);&#xD;&#xA;System.out.println(&quot;RUN_TS: &quot; + context.run_ts);&#xD;&#xA;System.out.println(&quot;AMBIENTE: &quot; + context.env);&#xD;&#xA;System.out.println(&quot;=======================================&quot;);"/>
