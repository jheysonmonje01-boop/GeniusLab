  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="400" posY="80">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Fecha única para toda la ejecución del perfilado&#xD;&#xA;java.util.Date dqRunTs = new java.util.Date();&#xD;&#xA;&#xD;&#xA;//Identificador único para toda la ejecución&#xD;&#xA;context.run_id = &quot;RUN-&quot; + System.currentTimeMillis();&#xD;&#xA;&#xD;&#xA;//Guardar fecha de ejecución para todas las métricas&#xD;&#xA;globalMap.put(&quot;DQ_RUN_TS&quot;, dqRunTs);&#xD;&#xA;&#xD;&#xA;//Crear lista global vacía donde se acumularán las métricas&#xD;&#xA;globalMap.put(&#xD;&#xA; &quot;PROFILE_METRICS&quot;,&#xD;&#xA; new java.util.ArrayList&lt;java.util.Map&lt;String, Object>>()&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;//Limpiar variable auxiliar de impresión&#xD;&#xA;globalMap.remove(&quot;PRINT_DYNAMIC_COLUMNS&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;=========================================&quot;);&#xD;&#xA;System.out.println(&quot;INICIO DEL PERFILADO&quot;);&#xD;&#xA;System.out.println(&quot;RUN ID: &quot; + context.run_id);&#xD;&#xA;System.out.println(&quot;RUN TS: &quot; + dqRunTs);&#xD;&#xA;System.out.println(&quot;=========================================&quot;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
