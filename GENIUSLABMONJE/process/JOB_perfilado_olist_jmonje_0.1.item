  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="920" posY="880">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_2" show="false"/>
    <elementParameter field="CHECK" name="ACTIVATE" value="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_START" value="java.util.Map&lt;String, Long> totalRows =&#xD;&#xA;new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String, Long> nullRows =&#xD;&#xA;new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String, Long> totalChars =&#xD;&#xA;new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String, java.util.Set&lt;String>> distinctValues =&#xD;&#xA;new java.util.HashMap&lt;String, java.util.Set&lt;String>>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String,String> dataTypes =&#xD;&#xA;new java.util.HashMap&lt;String,String>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String,String> minValues =&#xD;&#xA;new java.util.HashMap&lt;String,String>();&#xD;&#xA;&#xD;&#xA;java.util.Map&lt;String,String> maxValues =&#xD;&#xA;new java.util.HashMap&lt;String,String>();&#xA;"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="routines.system.Dynamic dyn = input_row.row;&#xD;&#xA;&#xD;&#xA;//Dataset actual proveniente del tFlowToIterate&#xD;&#xA;String datasetName =&#xD;&#xA;(String)globalMap.get(&quot;row5.dataset&quot;);&#xD;&#xA;&#xD;&#xA;//Mostrar estructura sólo una vez&#xD;&#xA;if(globalMap.get(&quot;PRINT_DYNAMIC_COLUMNS&quot;) == null)&#xD;&#xA;{&#xD;&#xA;System.out.println(&#xD;&#xA;   &quot;Columnas Dynamic = &quot;&#xD;&#xA;   + dyn.getColumnCount()&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;for(int i = 0; i &lt; dyn.getColumnCount(); i++)&#xD;&#xA;{&#xD;&#xA;   System.out.println(&#xD;&#xA;       &quot;Columna: &quot;&#xD;&#xA;       + dyn.getColumnMetadata(i).getName()&#xD;&#xA;   );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;globalMap.put(&#xD;&#xA;   &quot;PRINT_DYNAMIC_COLUMNS&quot;,&#xD;&#xA;   true&#xD;&#xA;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//Recorrer todas las columnas dinámicas&#xD;&#xA;for(int i = 0; i &lt; dyn.getColumnCount(); i++)&#xD;&#xA;{&#xD;&#xA;String columnName =&#xD;&#xA;   dyn.getColumnMetadata(i)&#xD;&#xA;      .getName()&#xD;&#xA;      .replace(&quot;\&quot;&quot;,&quot;&quot;);&#xD;&#xA;&#xD;&#xA;Object value =&#xD;&#xA;   dyn.getColumnValue(i);&#xD;&#xA;&#xD;&#xA;String key =&#xD;&#xA;   datasetName&#xD;&#xA;   + &quot;|&quot;&#xD;&#xA;   + columnName;&#xD;&#xA;&#xD;&#xA;// ==========================&#xD;&#xA;// Total registros&#xD;&#xA;// ==========================&#xD;&#xA;&#xD;&#xA;totalRows.put(&#xD;&#xA;   key,&#xD;&#xA;   totalRows.getOrDefault(&#xD;&#xA;       key,&#xD;&#xA;       0L&#xD;&#xA;   ) + 1&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;// ==========================&#xD;&#xA;// Nulos&#xD;&#xA;// ==========================&#xD;&#xA;&#xD;&#xA;boolean isNull =&#xD;&#xA;   (&#xD;&#xA;       value == null&#xD;&#xA;       ||&#xD;&#xA;       String.valueOf(value)&#xD;&#xA;             .trim()&#xD;&#xA;             .isEmpty()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;if(isNull)&#xD;&#xA;{&#xD;&#xA;   nullRows.put(&#xD;&#xA;       key,&#xD;&#xA;       nullRows.getOrDefault(&#xD;&#xA;           key,&#xD;&#xA;           0L&#xD;&#xA;       ) + 1&#xD;&#xA;   );&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;   String valueStr =&#xD;&#xA;       String.valueOf(value);&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Longitud acumulada&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   totalChars.put(&#xD;&#xA;       key,&#xD;&#xA;       totalChars.getOrDefault(&#xD;&#xA;           key,&#xD;&#xA;           0L&#xD;&#xA;       )&#xD;&#xA;       +&#xD;&#xA;       valueStr.length()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Cardinalidad&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   distinctValues&#xD;&#xA;       .computeIfAbsent(&#xD;&#xA;           key,&#xD;&#xA;           k -> new java.util.HashSet&lt;String>()&#xD;&#xA;       )&#xD;&#xA;       .add(&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Tipo de dato observado&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   dataTypes.putIfAbsent(&#xD;&#xA;       key,&#xD;&#xA;       value.getClass()&#xD;&#xA;            .getSimpleName()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Mínimo&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   String currentMin =&#xD;&#xA;       minValues.get(key);&#xD;&#xA;&#xD;&#xA;   if(&#xD;&#xA;       currentMin == null&#xD;&#xA;       ||&#xD;&#xA;       valueStr.compareTo(&#xD;&#xA;           currentMin&#xD;&#xA;       ) &lt; 0&#xD;&#xA;   )&#xD;&#xA;   {&#xD;&#xA;       minValues.put(&#xD;&#xA;           key,&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;   }&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Máximo&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   String currentMax =&#xD;&#xA;       maxValues.get(key);&#xD;&#xA;&#xD;&#xA;   if(&#xD;&#xA;       currentMax == null&#xD;&#xA;       ||&#xD;&#xA;       valueStr.compareTo(&#xD;&#xA;           currentMax&#xD;&#xA;       ) > 0&#xD;&#xA;   )&#xD;&#xA;   {&#xD;&#xA;       maxValues.put(&#xD;&#xA;           key,&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;   }&#xD;&#xA;}&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="for(String key : totalRows.keySet())&#xD;&#xA;{&#xD;&#xA;    Long total =&#xD;&#xA;        totalRows.getOrDefault(key,0L);&#xD;&#xA;&#xD;&#xA;    Long nullCount =&#xD;&#xA;        nullRows.getOrDefault(key,0L);&#xD;&#xA;&#xD;&#xA;    Long chars =&#xD;&#xA;        totalChars.getOrDefault(key,0L);&#xD;&#xA;&#xD;&#xA;    Long cardinality =&#xD;&#xA;        Long.valueOf(&#xD;&#xA;            distinctValues&#xD;&#xA;                .getOrDefault(&#xD;&#xA;                    key,&#xD;&#xA;                    new java.util.HashSet&lt;String>()&#xD;&#xA;                )&#xD;&#xA;                .size()&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;    Double avgLen =&#xD;&#xA;        total == 0&#xD;&#xA;        ? 0.0&#xD;&#xA;        : ((double)chars / total);&#xD;&#xA;&#xD;&#xA;    System.out.println(&#xD;&#xA;        key&#xD;&#xA;        + &quot; | total=&quot;&#xD;&#xA;        + total&#xD;&#xA;        + &quot; | nulls=&quot;&#xD;&#xA;        + nullCount&#xD;&#xA;        + &quot; | cardinality=&quot;&#xD;&#xA;        + cardinality&#xD;&#xA;        + &quot; | avg_len=&quot;&#xD;&#xA;        + avgLen&#xD;&#xA;    );&#xD;&#xA;}&#xA;"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.sql.Connection;&#xD;&#xA;import java.sql.DriverManager;&#xD;&#xA;import java.sql.PreparedStatement;&#xD;&#xA;import java.sql.Timestamp;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
