    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_START" value="java.util.List&lt;java.util.Map&lt;String, Object>> metricsToEmit =&#xD;&#xA;(java.util.List&lt;java.util.Map&lt;String, Object>>)&#xD;&#xA;globalMap.get(&quot;PROFILE_METRICS&quot;);&#xD;&#xA;&#xD;&#xA;if(metricsToEmit == null)&#xD;&#xA;{&#xD;&#xA;throw new RuntimeException(&#xD;&#xA;    &quot;No existe la lista PROFILE_METRICS&quot;&#xD;&#xA;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;=========================================&quot;);&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;TOTAL DE MÉTRICAS A EMITIR: &quot;&#xD;&#xA;+ metricsToEmit.size()&#xD;&#xA;);&#xD;&#xA;System.out.println(&quot;=========================================&quot;);&#xD;&#xA;&#xD;&#xA;for(&#xD;&#xA;java.util.Map&lt;String, Object> metric&#xD;&#xA;:&#xD;&#xA;metricsToEmit&#xD;&#xA;)&#xD;&#xA;{"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="out_profile.run_id =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;run_id&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.run_ts =&#xD;&#xA;(java.util.Date)&#xD;&#xA;metric.get(&quot;run_ts&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.dataset =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;dataset&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.column_name =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;column_name&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.data_type =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;data_type&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.rows_total =&#xD;&#xA;(Long)&#xD;&#xA;metric.get(&quot;rows_total&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.rows_null =&#xD;&#xA;(Long)&#xD;&#xA;metric.get(&quot;rows_null&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.pct_null =&#xD;&#xA;(java.math.BigDecimal)&#xD;&#xA;metric.get(&quot;pct_null&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.cardinality =&#xD;&#xA;(Long)&#xD;&#xA;metric.get(&quot;cardinality&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.min_val =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;min_val&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.max_val =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;max_val&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.avg_len =&#xD;&#xA;(java.math.BigDecimal)&#xD;&#xA;metric.get(&quot;avg_len&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.pattern_top =&#xD;&#xA;(String)&#xD;&#xA;metric.get(&quot;pattern_top&quot;);&#xD;&#xA;&#xD;&#xA;out_profile.pct_top =&#xD;&#xA;(java.math.BigDecimal)&#xD;&#xA;metric.get(&quot;pct_top&quot;);"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="}"/>
