  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="880" posY="240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_1" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_START" value="//======================================================&#xD;&#xA;//Mapas para acumular métricas por dataset y columna&#xD;&#xA;//La clave usada será: dataset|column_name&#xD;&#xA;//======================================================&#xD;&#xA;&#xD;&#xA;//Total de filas procesadas por columna&#xD;&#xA;java.util.Map&lt;String, Long> totalRows =&#xD;&#xA; new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;//Total de valores nulos o vacíos por columna&#xD;&#xA;java.util.Map&lt;String, Long> nullRows =&#xD;&#xA; new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;//Total de caracteres acumulados por columna&#xD;&#xA;//Se usa para calcular avg_len&#xD;&#xA;java.util.Map&lt;String, Long> totalChars =&#xD;&#xA; new java.util.HashMap&lt;String, Long>();&#xD;&#xA;&#xD;&#xA;//Valores distintos por columna&#xD;&#xA;//Se usa para calcular cardinality&#xD;&#xA;java.util.Map&lt;String, java.util.Set&lt;String>> distinctValues =&#xD;&#xA; new java.util.HashMap&lt;String, java.util.Set&lt;String>>();&#xD;&#xA;&#xD;&#xA;//Tipo de dato observado por columna&#xD;&#xA;java.util.Map&lt;String, String> dataTypes =&#xD;&#xA; new java.util.HashMap&lt;String, String>();&#xD;&#xA;&#xD;&#xA;//Valor mínimo observado por columna&#xD;&#xA;java.util.Map&lt;String, String> minValues =&#xD;&#xA; new java.util.HashMap&lt;String, String>();&#xD;&#xA;&#xD;&#xA;//Valor máximo observado por columna&#xD;&#xA;java.util.Map&lt;String, String> maxValues =&#xD;&#xA; new java.util.HashMap&lt;String, String>();"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="routines.system.Dynamic dyn = input_row.row;&#xD;&#xA;&#xD;&#xA;//Dataset actual proveniente del tFlowToIterate&#xD;&#xA;String datasetName =&#xD;&#xA;(String)globalMap.get(&quot;row1.dataset&quot;);&#xD;&#xA;&#xD;&#xA;//Mostrar estructura sólo una vez&#xD;&#xA;if(globalMap.get(&quot;PRINT_DYNAMIC_COLUMNS&quot;) == null)&#xD;&#xA;{&#xD;&#xA;System.out.println(&#xD;&#xA;   &quot;Columnas Dynamic = &quot;&#xD;&#xA;   + dyn.getColumnCount()&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;for(int i = 0; i &lt; dyn.getColumnCount(); i++)&#xD;&#xA;{&#xD;&#xA;   System.out.println(&#xD;&#xA;       &quot;Columna: &quot;&#xD;&#xA;       + dyn.getColumnMetadata(i).getName()&#xD;&#xA;   );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;globalMap.put(&#xD;&#xA;   &quot;PRINT_DYNAMIC_COLUMNS&quot;,&#xD;&#xA;   true&#xD;&#xA;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//Recorrer todas las columnas dinámicas&#xD;&#xA;for(int i = 0; i &lt; dyn.getColumnCount(); i++)&#xD;&#xA;{&#xD;&#xA;String columnName =&#xD;&#xA;   dyn.getColumnMetadata(i)&#xD;&#xA;      .getName()&#xD;&#xA;      .replace(&quot;\&quot;&quot;,&quot;&quot;);&#xD;&#xA;&#xD;&#xA;Object value =&#xD;&#xA;   dyn.getColumnValue(i);&#xD;&#xA;&#xD;&#xA;String key =&#xD;&#xA;   datasetName&#xD;&#xA;   + &quot;|&quot;&#xD;&#xA;   + columnName;&#xD;&#xA;&#xD;&#xA;// ==========================&#xD;&#xA;// Total registros&#xD;&#xA;// ==========================&#xD;&#xA;&#xD;&#xA;totalRows.put(&#xD;&#xA;   key,&#xD;&#xA;   totalRows.getOrDefault(&#xD;&#xA;       key,&#xD;&#xA;       0L&#xD;&#xA;   ) + 1&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;// ==========================&#xD;&#xA;// Nulos&#xD;&#xA;// ==========================&#xD;&#xA;&#xD;&#xA;boolean isNull =&#xD;&#xA;   (&#xD;&#xA;       value == null&#xD;&#xA;       ||&#xD;&#xA;       String.valueOf(value)&#xD;&#xA;             .trim()&#xD;&#xA;             .isEmpty()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;if(isNull)&#xD;&#xA;{&#xD;&#xA;   nullRows.put(&#xD;&#xA;       key,&#xD;&#xA;       nullRows.getOrDefault(&#xD;&#xA;           key,&#xD;&#xA;           0L&#xD;&#xA;       ) + 1&#xD;&#xA;   );&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;   String valueStr =&#xD;&#xA;       String.valueOf(value);&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Longitud acumulada&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   totalChars.put(&#xD;&#xA;       key,&#xD;&#xA;       totalChars.getOrDefault(&#xD;&#xA;           key,&#xD;&#xA;           0L&#xD;&#xA;       )&#xD;&#xA;       +&#xD;&#xA;       valueStr.length()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Cardinalidad&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   distinctValues&#xD;&#xA;       .computeIfAbsent(&#xD;&#xA;           key,&#xD;&#xA;           k -> new java.util.HashSet&lt;String>()&#xD;&#xA;       )&#xD;&#xA;       .add(&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Tipo de dato observado&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   dataTypes.putIfAbsent(&#xD;&#xA;       key,&#xD;&#xA;       value.getClass()&#xD;&#xA;            .getSimpleName()&#xD;&#xA;   );&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Mínimo&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   String currentMin =&#xD;&#xA;       minValues.get(key);&#xD;&#xA;&#xD;&#xA;   if(&#xD;&#xA;       currentMin == null&#xD;&#xA;       ||&#xD;&#xA;       valueStr.compareTo(&#xD;&#xA;           currentMin&#xD;&#xA;       ) &lt; 0&#xD;&#xA;   )&#xD;&#xA;   {&#xD;&#xA;       minValues.put(&#xD;&#xA;           key,&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;   }&#xD;&#xA;&#xD;&#xA;   // ==========================&#xD;&#xA;   // Máximo&#xD;&#xA;   // ==========================&#xD;&#xA;&#xD;&#xA;   String currentMax =&#xD;&#xA;       maxValues.get(key);&#xD;&#xA;&#xD;&#xA;   if(&#xD;&#xA;       currentMax == null&#xD;&#xA;       ||&#xD;&#xA;       valueStr.compareTo(&#xD;&#xA;           currentMax&#xD;&#xA;       ) > 0&#xD;&#xA;   )&#xD;&#xA;   {&#xD;&#xA;       maxValues.put(&#xD;&#xA;           key,&#xD;&#xA;           valueStr&#xD;&#xA;       );&#xD;&#xA;   }&#xD;&#xA;}&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="//Recuperar la lista global creada en tJava_1&#xD;&#xA;java.util.List&lt;java.util.Map&lt;String, Object>> profileMetrics =&#xD;&#xA; (java.util.List&lt;java.util.Map&lt;String, Object>>)&#xD;&#xA; globalMap.get(&quot;PROFILE_METRICS&quot;);&#xD;&#xA;&#xD;&#xA;if (profileMetrics == null)&#xD;&#xA;{&#xD;&#xA; throw new RuntimeException(&#xD;&#xA;     &quot;PROFILE_METRICS no fue inicializada en tJava_1&quot;&#xD;&#xA; );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//Recuperar la fecha única de toda la ejecución&#xD;&#xA;java.util.Date dqRunTs =&#xD;&#xA; (java.util.Date)&#xD;&#xA; globalMap.get(&quot;DQ_RUN_TS&quot;);&#xD;&#xA;&#xD;&#xA;int metricasDatasetActual = 0;&#xD;&#xA;&#xD;&#xA;//Crear una métrica por cada columna analizada&#xD;&#xA;for(String key : totalRows.keySet())&#xD;&#xA;{&#xD;&#xA; Long total =&#xD;&#xA;     totalRows.getOrDefault(&#xD;&#xA;         key,&#xD;&#xA;         0L&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; Long nullCount =&#xD;&#xA;     nullRows.getOrDefault(&#xD;&#xA;         key,&#xD;&#xA;         0L&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; Long chars =&#xD;&#xA;     totalChars.getOrDefault(&#xD;&#xA;         key,&#xD;&#xA;         0L&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; Long rowsNotNull =&#xD;&#xA;     Math.max(&#xD;&#xA;         0L,&#xD;&#xA;         total - nullCount&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; Long cardinality =&#xD;&#xA;     Long.valueOf(&#xD;&#xA;         distinctValues&#xD;&#xA;             .getOrDefault(&#xD;&#xA;                 key,&#xD;&#xA;                 new java.util.HashSet&lt;String>()&#xD;&#xA;             )&#xD;&#xA;             .size()&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; // avg_len se calcula únicamente con filas no nulas&#xD;&#xA; java.math.BigDecimal avgLen =&#xD;&#xA;     rowsNotNull == 0L&#xD;&#xA;     ?&#xD;&#xA;     java.math.BigDecimal.ZERO.setScale(2)&#xD;&#xA;     :&#xD;&#xA;     java.math.BigDecimal&#xD;&#xA;         .valueOf(&#xD;&#xA;             (double) chars / rowsNotNull&#xD;&#xA;         )&#xD;&#xA;         .setScale(&#xD;&#xA;             2,&#xD;&#xA;             java.math.RoundingMode.HALF_UP&#xD;&#xA;         );&#xD;&#xA;&#xD;&#xA; java.math.BigDecimal pctNull =&#xD;&#xA;     total == 0L&#xD;&#xA;     ?&#xD;&#xA;     java.math.BigDecimal.ZERO.setScale(3)&#xD;&#xA;     :&#xD;&#xA;     java.math.BigDecimal&#xD;&#xA;         .valueOf(&#xD;&#xA;             ((double) nullCount / total) * 100.0&#xD;&#xA;         )&#xD;&#xA;         .setScale(&#xD;&#xA;             3,&#xD;&#xA;             java.math.RoundingMode.HALF_UP&#xD;&#xA;         );&#xD;&#xA;&#xD;&#xA; // La clave tiene el formato dataset|column_name&#xD;&#xA; String[] keyParts =&#xD;&#xA;     key.split(&#xD;&#xA;         &quot;\\|&quot;,&#xD;&#xA;         2&#xD;&#xA;     );&#xD;&#xA;&#xD;&#xA; String datasetName =&#xD;&#xA;     keyParts.length > 0&#xD;&#xA;     ? keyParts[0]&#xD;&#xA;     : null;&#xD;&#xA;&#xD;&#xA; String columnName =&#xD;&#xA;     keyParts.length > 1&#xD;&#xA;     ? keyParts[1]&#xD;&#xA;     : null;&#xD;&#xA;&#xD;&#xA; String dataType =&#xD;&#xA;     dataTypes.get(key);&#xD;&#xA;&#xD;&#xA; String minValue =&#xD;&#xA;     minValues.get(key);&#xD;&#xA;&#xD;&#xA; String maxValue =&#xD;&#xA;     maxValues.get(key);&#xD;&#xA;&#xD;&#xA; // Respetar tamaños máximos de SingleStore&#xD;&#xA; if(datasetName != null &amp;&amp; datasetName.length() > 128)&#xD;&#xA; {&#xD;&#xA;     datasetName =&#xD;&#xA;         datasetName.substring(&#xD;&#xA;             0,&#xD;&#xA;             128&#xD;&#xA;         );&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; if(columnName != null &amp;&amp; columnName.length() > 128)&#xD;&#xA; {&#xD;&#xA;     columnName =&#xD;&#xA;         columnName.substring(&#xD;&#xA;             0,&#xD;&#xA;             128&#xD;&#xA;         );&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; if(dataType != null &amp;&amp; dataType.length() > 64)&#xD;&#xA; {&#xD;&#xA;     dataType =&#xD;&#xA;         dataType.substring(&#xD;&#xA;             0,&#xD;&#xA;             64&#xD;&#xA;         );&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; if(minValue != null &amp;&amp; minValue.length() > 256)&#xD;&#xA; {&#xD;&#xA;     minValue =&#xD;&#xA;         minValue.substring(&#xD;&#xA;             0,&#xD;&#xA;             256&#xD;&#xA;         );&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; if(maxValue != null &amp;&amp; maxValue.length() > 256)&#xD;&#xA; {&#xD;&#xA;     maxValue =&#xD;&#xA;         maxValue.substring(&#xD;&#xA;             0,&#xD;&#xA;             256&#xD;&#xA;         );&#xD;&#xA; }&#xD;&#xA;&#xD;&#xA; // Crear objeto que representa una fila de stg_dq_profile&#xD;&#xA; java.util.Map&lt;String, Object> metric =&#xD;&#xA;     new java.util.HashMap&lt;String, Object>();&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;run_id&quot;,&#xD;&#xA;     context.run_id&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;run_ts&quot;,&#xD;&#xA;     dqRunTs&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;dataset&quot;,&#xD;&#xA;     datasetName&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;column_name&quot;,&#xD;&#xA;     columnName&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;data_type&quot;,&#xD;&#xA;     dataType&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;rows_total&quot;,&#xD;&#xA;     total&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;rows_null&quot;,&#xD;&#xA;     nullCount&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;pct_null&quot;,&#xD;&#xA;     pctNull&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;cardinality&quot;,&#xD;&#xA;     cardinality&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;min_val&quot;,&#xD;&#xA;     minValue&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;max_val&quot;,&#xD;&#xA;     maxValue&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;avg_len&quot;,&#xD;&#xA;     avgLen&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; // Estas métricas todavía no son calculadas por el código actual&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;pattern_top&quot;,&#xD;&#xA;     null&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; metric.put(&#xD;&#xA;     &quot;pct_top&quot;,&#xD;&#xA;     null&#xD;&#xA; );&#xD;&#xA;&#xD;&#xA; // Guardar métrica en la lista global&#xD;&#xA; profileMetrics.add(metric);&#xD;&#xA;&#xD;&#xA; metricasDatasetActual++;&#xD;&#xA;&#xD;&#xA; System.out.println(&#xD;&#xA;     &quot;Métrica acumulada: &quot;&#xD;&#xA;     + datasetName&#xD;&#xA;     + &quot;.&quot;&#xD;&#xA;     + columnName&#xD;&#xA;     + &quot; | total=&quot;&#xD;&#xA;     + total&#xD;&#xA;     + &quot; | nulls=&quot;&#xD;&#xA;     + nullCount&#xD;&#xA;     + &quot; | pct_null=&quot;&#xD;&#xA;     + pctNull&#xD;&#xA;     + &quot; | cardinality=&quot;&#xD;&#xA;     + cardinality&#xD;&#xA;     + &quot; | avg_len=&quot;&#xD;&#xA;     + avgLen&#xD;&#xA; );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA; &quot;Métricas agregadas para el dataset actual: &quot;&#xD;&#xA; + metricasDatasetActual&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA; &quot;Métricas acumuladas en memoria: &quot;&#xD;&#xA; + profileMetrics.size()&#xD;&#xA;);"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="import java.sql.Connection;&#xD;&#xA;import java.sql.DriverManager;&#xD;&#xA;import java.sql.PreparedStatement;&#xD;&#xA;import java.sql.Timestamp;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
