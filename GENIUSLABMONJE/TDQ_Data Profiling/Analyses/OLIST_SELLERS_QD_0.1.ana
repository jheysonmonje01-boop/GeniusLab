      <indicators xsi:type="dataquality.indicators:PatternFreqIndicator" xmi:id="_HzpgkF6aEfGIxbSF4Pb83Q" count="3095" computed="true" distinctValueCount="1" uniqueValueCount="0" valueToFreq="">
        <parameters xmi:id="_HzpgkV6aEfGIxbSF4Pb83Q"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/OLIST/olist_sellers_dataset_csv_0.1.item#_gxp6Nl6TEfGIxbSF4Pb83Q"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Pattern Frequency Statistics/Pattern_Frequency_Table_0.1.definition#_kQzTsJR-Ed2XO-JvLwVAwg"/>
        <builtInIndicatorDefinition xmi:id="_IKmnwF6aEfGIxbSF4Pb83Q" name="Pattern Frequency Table" label="Pattern Frequency Table">
          <taggedValue xmi:id="_IKmnwV6aEfGIxbSF4Pb83Q" tag="Description" value="counts the number of records for each distinct pattern"/>
          <taggedValue xmi:id="_IKmnwl6aEfGIxbSF4Pb83Q" tag="Purpose" value="evaluates the most frequent patterns"/>
          <sqlGenericExpression xmi:id="_IKmnw16aEfGIxbSF4Pb83Q" body="SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) c FROM &lt;%=__TABLE_NAME__%> t &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__GROUP_BY_ALIAS__%> ORDER BY c DESC" language="SQL"/>
          <sqlGenericExpression xmi:id="_IKmnxF6aEfGIxbSF4Pb83Q" body="SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) c FROM &lt;%=__TABLE_NAME__%> t &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__GROUP_BY_ALIAS__%> ORDER BY c DESC" language="MySQL"/>
          <sqlGenericExpression xmi:id="_IKmnxV6aEfGIxbSF4Pb83Q" body="SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) AS c FROM &lt;%=__TABLE_NAME__%> t &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__COLUMN_NAMES__%> ORDER BY c DESC" language="Oracle"/>
