      <indicators xsi:type="dataquality.indicators:SoundexFreqIndicator" xmi:id="_HzpgXl6aEfGIxbSF4Pb83Q" count="3095" computed="true" distinctValueCount="10" uniqueValueCount="3095" valueToFreq="" valueToDistinctFreq="">
        <parameters xmi:id="_HzpgX16aEfGIxbSF4Pb83Q"/>
