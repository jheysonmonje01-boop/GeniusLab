        <builtInIndicatorDefinition xmi:id="_IJso0F6aEfGIxbSF4Pb83Q" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_IJso0V6aEfGIxbSF4Pb83Q" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_IJso0l6aEfGIxbSF4Pb83Q" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_IJso016aEfGIxbSF4Pb83Q" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
