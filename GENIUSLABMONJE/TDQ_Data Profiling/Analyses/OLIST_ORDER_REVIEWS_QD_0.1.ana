          <taggedValue xmi:id="_SBqo8l6ZEfGIxbSF4Pb83Q" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_SBqo816ZEfGIxbSF4Pb83Q" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_Rp63ZF6ZEfGIxbSF4Pb83Q" count="4589" computed="true">
