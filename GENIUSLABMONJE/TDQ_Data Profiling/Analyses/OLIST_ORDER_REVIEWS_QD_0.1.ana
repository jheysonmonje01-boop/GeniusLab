          <textParameter xmi:id="_Rp63jF6ZEfGIxbSF4Pb83Q" useBlank="false"/>
        </parameters>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/OLIST/olist_order_reviews_dataset_csv_0.1.item#_6uN_V16SEfGIxbSF4Pb83Q"/>
