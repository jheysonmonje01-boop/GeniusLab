        <builtInIndicatorDefinition xmi:id="_huC3sF6YEfGIxbSF4Pb83Q" name="Pattern Frequency Table" label="Pattern Frequency Table">
          <taggedValue xmi:id="_huC3sV6YEfGIxbSF4Pb83Q" tag="Description" value="counts the number of records for each distinct pattern"/>
          <taggedValue xmi:id="_huC3sl6YEfGIxbSF4Pb83Q" tag="Purpose" value="evaluates the most frequent patterns"/>
          <sqlGenericExpression xmi:id="_huC3s16YEfGIxbSF4Pb83Q" body="SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) c FROM &lt;%=__TABLE_NAME__%> t &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__GROUP_BY_ALIAS__%> ORDER BY c DESC" language="SQL"/>
          <sqlGenericExpression xmi:id="_huC3tF6YEfGIxbSF4Pb83Q" body="SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) c FROM &lt;%=__TABLE_NAME__%> t &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__GROUP_BY_ALIAS__%> ORDER BY c DESC" language="MySQL"/>
