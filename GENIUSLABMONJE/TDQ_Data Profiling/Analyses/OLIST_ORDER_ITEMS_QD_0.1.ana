      <indicators xsi:type="dataquality.indicators:SoundexFreqIndicator" xmi:id="_hW3G7V6YEfGIxbSF4Pb83Q" count="112650" computed="true" distinctValueCount="10" uniqueValueCount="18117" valueToFreq="" valueToDistinctFreq="">
