          <taggedValue xmi:id="_hvBvIl6YEfGIxbSF4Pb83Q" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_hvBvI16YEfGIxbSF4Pb83Q" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
