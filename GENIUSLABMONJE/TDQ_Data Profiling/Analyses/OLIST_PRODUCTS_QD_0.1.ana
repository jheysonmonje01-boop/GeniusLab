      <indicators xsi:type="dataquality.indicators:SoundexFreqIndicator" xmi:id="_vM3X3l6ZEfGIxbSF4Pb83Q" count="32951" computed="true" distinctValueCount="10" uniqueValueCount="32951" valueToFreq="" valueToDistinctFreq="">
