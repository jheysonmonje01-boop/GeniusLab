      <indicators xsi:type="dataquality.indicators:PatternFreqIndicator" xmi:id="_y0x2mV6VEfGIxbSF4Pb83Q" count="99441" computed="true" distinctValueCount="5" uniqueValueCount="0" valueToFreq="">
        <parameters xmi:id="_y0x2ml6VEfGIxbSF4Pb83Q"/>
